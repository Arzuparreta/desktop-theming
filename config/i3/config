set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
###############################################################################
# AUTOSTART
###############################################################################
exec_always --no-startup-id ~/.local/bin/walltheme restore --no-polybar
exec_always mkfifo /tmp/xobpipe && tail -f /tmp/xobpipe | xob -t 2170 & disown
exec --no-startup-id redshift exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id "i3-msg 'workspace 1; exec kitty'"
exec_always --no-startup-id ~/.config/polybar/launch.sh
exec_always autorandr --change &
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP
exec --no-startup-id dunst
###############################################################################
# VARIABLES & GLOBAL SETTINGS
###############################################################################
set $mod Mod4
set $term kitty
font pango:JetBrains Mono 14 
floating_modifier $mod
# This removes title bars from all windows
default_border pixel 2
default_floating_border pixel 2
###############################################################################
# WINDOW RULES
###############################################################################
for_window [title="Calculator"] floating enable
for_window [class="mpv"] floating enable
############################################################################## 
# THEME & APPEARANCE 
############################################################################### 
set_from_resource $bg i3wm.color0 #000000 
set_from_resource $fg i3wm.color15 #ffffff 
set_from_resource $inactive_border i3wm.color8 #222222 
set_from_resource $active_border i3wm.color4 #005577 
set_from_resource $urgent_border i3wm.color1 #cc0000 
# class                 border         backgr. text indicator child_border 
client.focused          $active_border $bg     $fg  $active_border $active_border 
client.focused_inactive #000000        $bg     $fg  #000000        #000000 
client.unfocused        #000000        $bg     $fg  #000000        #000000 
client.urgent           $urgent_border $bg     $fg  $urgent_border $urgent_border 
client.placeholder      #000000        $bg     $fg  #000000        #000000 
client.background       $bg
###############################################################################
# KEYBINDINGS - APPLICATIONS
###############################################################################
bindsym $mod+q exec $term
bindsym $mod+e exec thunar
bindsym $mod+Shift+b exec firefox
bindsym $mod+b exec fly-browser 
bindsym $mod+space exec rofi -show drun
# wallpaper + theme menu (walltheme); Mod+Shift+w toggles light/dark (e.g. outdoors)
bindsym $mod+w exec --no-startup-id ~/.local/bin/wallpaper-menu
bindsym $mod+Shift+w exec --no-startup-id ~/.local/bin/walltheme toggle-polarity
# open Soundsible webapp and Soundsible daemon
bindsym $mod+s exec chromium --app=http://localhost:5005/player/desktop/    
bindsym $mod+Shift+s exec $term /home/arsu/Git-projects/soundsible/run.py --daemon
###############################################################################
# KEYBINDINGS - WINDOW MANAGEMENT
###############################################################################
bindsym $mod+c kill
bindsym $mod+f fullscreen toggle
bindsym $mod+t split toggle
bindsym $mod+Tab layout toggle all
bindsym $mod+a focus parent
bindsym $mod+Shift+p floating toggle
bindsym $mod+p focus mode_toggle
# Focus (Vim style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
# Move (Vim style)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
###############################################################################
# KEYBINDINGS - WORKSPACES
###############################################################################
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10
###############################################################################
# KEYBINDINGS - SYSTEM
###############################################################################
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -b 'Yes' 'i3-msg exit'"
mode "resize" {
    bindsym h resize shrink width 5 px or 5 ppt
    bindsym j resize grow height 5 px or 5 ppt
    bindsym k resize shrink height 5 px or 5 ppt
    bindsym l resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
# Audio
bindsym XF86AudioRaiseVolume exec "pamixer -ui 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioLowerVolume exec "pamixer -ud 3 && pamixer --get-volume > /tmp/xobpipe"
bindsym XF86AudioMute exec "amixer sset Master toggle | sed -En '/\[on\]/ s/.*\[([0-9]+)%\].*/\1/ p; /\[off\]/ s/.*/0/p' | head -1 > /tmp/xobpipe"
#brightnessctl
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5% 
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%- 
# Mic
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && notify-send "Mic toggled"
# Wifi
bindsym XF86WLAN exec --no-startup-id nmcli radio wifi toggle && notify-send "WiFi toggled"
# Bluetooth
bindsym XF86Bluetooth exec --no-startup-id rfkill toggle bluetooth && notify-send "Bluetooth toggled"
# Screenshot
bindsym Print exec "flameshot gui"
bindsym $mod+Mod1+t exec --no-startup-id kitty /bin/bash -lc "/home/arsu/scripts/toggle_battery.sh travel"
bindsym $mod+Mod1+h exec --no-startup-id kitty /bin/bash -lc "/home/arsu/scripts/toggle_battery.sh home"
bindsym $mod+v exec ~/dictate.sh begin
bindsym $mod+x exec ~/dictate.sh end
bindsym $mod+Shift+x exec ~/dictate.sh cancel
